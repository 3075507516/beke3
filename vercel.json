{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/status",
      "headers": {
        "content-type": "application/json"
      },
      "status": 200
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
