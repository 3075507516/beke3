# 管理员认证与会话安全（至少 6 位密码、至少 32 位独立随机会话密钥）
ADMIN_USERNAME=fox
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 发信服务（Resend / SMTP / SendCloud / Brevo / SendGrid）
MAIL_PROVIDER=smtp
MAIL_SENDER=service@yourdomain.com
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=service@yourdomain.com
SMTP_PASS=

# 收件 IMAP（阿里云企业邮箱免费版 imap.qiye.aliyun.com / 腾讯企业邮箱免费版 imap.exmail.qq.com）
IMAP_HOST=imap.qiye.aliyun.com
IMAP_PORT=993
IMAP_USER=service@yourdomain.com
IMAP_PASS=
IMAP_TLS=true

# Resend 可选配置
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# 支付宝支付（RSA2）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_PID=
ALIPAY_NOTIFY_URL=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 微信支付 v3（Native）
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_CERT=
WECHAT_NOTIFY_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=
STRIPE_CNY_RATE=0.14

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PAYPAL_CNY_RATE=0.14
